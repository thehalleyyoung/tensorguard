# Source distribution contents (Step 69).
# Ship the docs and license needed for a complete, reproducible sdist; keep
# heavy research artifacts and throwaway state out of the package.
include LICENSE
include README.md
include API.md
include SOUNDNESS_CONTRACT.md
include VERIFIABLE_FRAGMENT.md
include GETTING_STARTED.md
include LIMITATIONS.md
include py.typed
recursive-include src *.py py.typed

# Exclusions: keep the distribution lean and deterministic.
exclude 100_STEPS.md
prune tests
prune docs
prune experiments
prune reproducibility
prune .github
global-exclude __pycache__ *.pyc *.pyo .DS_Store
