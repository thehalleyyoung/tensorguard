{
  "_question": "Round-8 reviewer Q3: where in the codebase is the mapping from TG refinement variables to Dynamo guard expressions defined as data, so a third party can mechanically check the inclusion against a chosen torch version?",
  "_answer_summary": "This file is the data.  Each row is one TG operator-rule premise variable, the symbolic expression it appears in, and the matching Dynamo specialiser metadata read.  A third party can recompute the inclusion by (i) freezing a torch version, (ii) running the verifier in `experiments_v5/v8/dynamo_correspondence_data_check.py` which symbolically walks the in-tree `torch._subclasses.fake_tensor`/`torch._dynamo.guards` source against the metadata-read column of this file, and (iii) confirming each TG refinement variable's read appears in Dynamo's metadata-read set on the matching aten op.",
  "torch_version": "2.9.1",
  "fake_tensor_module": "torch._subclasses.fake_tensor",
  "dynamo_guards_module": "torch._dynamo.guards",
  "rules": [
    {"tg_var": "shape[0..r-1]", "rule": "T-Linear",                "premise": "in_features = X.shape[-1]",                                  "aten_op": "aten::linear",                  "dynamo_read": "FakeTensor.size(-1)",                              "guard_kind": "TENSOR_MATCH"},
    {"tg_var": "shape[0..r-1]", "rule": "T-Conv2d",                "premise": "in_channels = X.shape[1]",                                   "aten_op": "aten::convolution",             "dynamo_read": "FakeTensor.size(1)",                               "guard_kind": "TENSOR_MATCH"},
    {"tg_var": "rank",          "rule": "T-View",                  "premise": "rank(X.view(d0..dk)) = k",                                   "aten_op": "aten::view",                    "dynamo_read": "FakeTensor.dim()",                                 "guard_kind": "TENSOR_MATCH"},
    {"tg_var": "shape_product", "rule": "T-View",                  "premise": "prod(X.shape) == prod(new_shape)",                            "aten_op": "aten::view",                    "dynamo_read": "FakeTensor.numel()",                               "guard_kind": "TENSOR_MATCH"},
    {"tg_var": "rank",          "rule": "T-Reshape",               "premise": "rank(X.reshape(d0..dk)) = k",                                "aten_op": "aten::reshape",                 "dynamo_read": "FakeTensor.dim()",                                 "guard_kind": "TENSOR_MATCH"},
    {"tg_var": "shape[i]",      "rule": "T-Transpose",             "premise": "X.transpose(i,j) swaps dims i,j",                            "aten_op": "aten::transpose.int",           "dynamo_read": "FakeTensor.size(i), .size(j)",                     "guard_kind": "TENSOR_MATCH"},
    {"tg_var": "rank+1",        "rule": "T-Unsqueeze",             "premise": "rank(X.unsqueeze(d)) = rank(X)+1",                           "aten_op": "aten::unsqueeze",               "dynamo_read": "FakeTensor.dim()",                                 "guard_kind": "TENSOR_MATCH"},
    {"tg_var": "rank-1",        "rule": "T-Squeeze",               "premise": "rank(X.squeeze(d)) = rank(X)-1 if shape[d]=1",                "aten_op": "aten::squeeze.dim",             "dynamo_read": "FakeTensor.dim(), .size(d)",                       "guard_kind": "TENSOR_MATCH"},
    {"tg_var": "shape[-2..]",   "rule": "T-Matmul",                "premise": "X.shape[-1] == Y.shape[-2]",                                  "aten_op": "aten::matmul",                  "dynamo_read": "FakeTensor.size(-1), .size(-2)",                   "guard_kind": "TENSOR_MATCH"},
    {"tg_var": "shape[-2..]",   "rule": "T-BMM",                   "premise": "X.shape[-1] == Y.shape[-2] and shape[0:-2] match",            "aten_op": "aten::bmm",                     "dynamo_read": "FakeTensor.size(-1), .size(-2), .size(0)",         "guard_kind": "TENSOR_MATCH"},
    {"tg_var": "broadcast",     "rule": "T-BroadcastAdd",          "premise": "broadcast_compatible(X.shape, Y.shape)",                      "aten_op": "aten::add.Tensor",              "dynamo_read": "FakeTensor.shape (full)",                          "guard_kind": "TENSOR_MATCH"},
    {"tg_var": "broadcast",     "rule": "T-BroadcastMul",          "premise": "broadcast_compatible(X.shape, Y.shape)",                      "aten_op": "aten::mul.Tensor",              "dynamo_read": "FakeTensor.shape (full)",                          "guard_kind": "TENSOR_MATCH"},
    {"tg_var": "shape[i]",      "rule": "T-Cat",                   "premise": "shape match on all dims except dim",                          "aten_op": "aten::cat",                     "dynamo_read": "FakeTensor.shape (per input)",                     "guard_kind": "TENSOR_MATCH"},
    {"tg_var": "shape[dim]",    "rule": "T-Stack",                 "premise": "all inputs have same shape",                                  "aten_op": "aten::stack",                   "dynamo_read": "FakeTensor.shape (per input)",                     "guard_kind": "TENSOR_MATCH"},
    {"tg_var": "shape[dim]",    "rule": "T-Split",                 "premise": "shape[dim] divides into chunks",                              "aten_op": "aten::split",                   "dynamo_read": "FakeTensor.size(dim)",                             "guard_kind": "TENSOR_MATCH"},
    {"tg_var": "shape[dim]",    "rule": "T-Chunk",                 "premise": "shape[dim] = chunks * chunk_size",                            "aten_op": "aten::tensor_split",            "dynamo_read": "FakeTensor.size(dim)",                             "guard_kind": "TENSOR_MATCH"},
    {"tg_var": "shape[i]",      "rule": "T-Expand",                "premise": "expanded[i] divides expand[i] or expand[i] == -1",            "aten_op": "aten::expand",                  "dynamo_read": "FakeTensor.size(i)",                               "guard_kind": "TENSOR_MATCH"},
    {"tg_var": "shape[dim]",    "rule": "T-Sum/Mean",              "premise": "rank decreases by 1 if not keepdim",                          "aten_op": "aten::sum.dim, aten::mean.dim", "dynamo_read": "FakeTensor.size(dim)",                             "guard_kind": "TENSOR_MATCH"},
    {"tg_var": "shape[i]",      "rule": "T-Index",                 "premise": "0 <= idx < shape[dim]",                                       "aten_op": "aten::index_select",            "dynamo_read": "FakeTensor.size(dim)",                             "guard_kind": "TENSOR_MATCH"},
    {"tg_var": "shape[i]",      "rule": "T-Slice",                 "premise": "0 <= start <= end <= shape[dim]",                             "aten_op": "aten::slice.Tensor",            "dynamo_read": "FakeTensor.size(dim)",                             "guard_kind": "TENSOR_MATCH"},
    {"tg_var": "shape[-1]",     "rule": "T-Softmax",               "premise": "softmax dim valid; rank preserved",                           "aten_op": "aten::_softmax",                "dynamo_read": "FakeTensor.dim(), .size(dim)",                     "guard_kind": "TENSOR_MATCH"},
    {"tg_var": "shape[-1]",     "rule": "T-LogSoftmax",            "premise": "logsoftmax dim valid; rank preserved",                        "aten_op": "aten::_log_softmax",            "dynamo_read": "FakeTensor.dim(), .size(dim)",                     "guard_kind": "TENSOR_MATCH"},
    {"tg_var": "shape[-1]",     "rule": "T-LayerNorm",             "premise": "normalized_shape suffix-matches X.shape",                     "aten_op": "aten::native_layer_norm",       "dynamo_read": "FakeTensor.shape (suffix)",                        "guard_kind": "TENSOR_MATCH"},
    {"tg_var": "shape[1]",      "rule": "T-BatchNorm",             "premise": "X.shape[1] == num_features",                                  "aten_op": "aten::native_batch_norm",       "dynamo_read": "FakeTensor.size(1)",                               "guard_kind": "TENSOR_MATCH"},
    {"tg_var": "shape[1]",      "rule": "T-Embedding",             "premise": "indices in [0, num_embeddings)",                              "aten_op": "aten::embedding",               "dynamo_read": "FakeTensor.size(1)",                               "guard_kind": "TENSOR_MATCH"},
    {"tg_var": "g (grad-flag)", "rule": "T-NoGrad",                "premise": "all outputs have requires_grad=False",                        "aten_op": "aten::detach",                  "dynamo_read": "FakeTensor.requires_grad",                         "guard_kind": "DUAL_LEVEL_NN_MODULE"},
    {"tg_var": "g (grad-flag)", "rule": "T-Detach",                "premise": "result requires_grad=False",                                  "aten_op": "aten::detach",                  "dynamo_read": "FakeTensor.requires_grad",                         "guard_kind": "DUAL_LEVEL_NN_MODULE"},
    {"tg_var": "shape[0..r-1]", "rule": "T-Permute",               "premise": "permutation maps dims 0..r-1 -> 0..r-1",                      "aten_op": "aten::permute",                 "dynamo_read": "FakeTensor.dim(), .size(*)",                       "guard_kind": "TENSOR_MATCH"}
  ],
  "n_rules": 28,
  "lean_audited_subset": "lean/TensorGuard/V5OperatorRules.lean exports the same 28 rules; lean/TensorGuard/lean_rule_table.json mirrors this file's `rule` column at JSON-export time.",
  "fragment_inclusion_claim": "Every `dynamo_read` column entry above is a metadata read on a FakeTensor that Dynamo's specialiser issues on the corresponding aten op for a TG-Verified module under torch 2.9.1. The verifier in experiments_v5/v8/dynamo_correspondence_data_check.py checks this row-wise against torch._subclasses.fake_tensor and torch._dynamo.guards on import."
}
